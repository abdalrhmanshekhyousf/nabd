// Nabd database schema.
// Every model except Hospital carries a hospitalId and every query is scoped by it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DOCTOR
  NURSE
  PHARMACIST
  LAB_TECHNICIAN
  RADIOLOGIST
  CLEANER
  RECEPTIONIST
  ACCOUNTANT
  PATIENT
}

enum Language {
  AR
  EN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// Built-in departments the admin can add in one click. The UI translates them by
// code; custom departments have no code and show their stored name.
// A nurse's type (ER, OR, ward) follows the code of the department they work in.
enum DepartmentCode {
  EMERGENCY
  OPERATIONS
  INTERNAL_MEDICINE
  NEUROLOGY
  ORTHOPEDICS
  CARDIOLOGY
  PLASTIC_SURGERY
  OPHTHALMOLOGY
  GYNECOLOGY
  LABORATORY
  RADIOLOGY
  PHARMACY
}

enum BedStatus {
  EMPTY
  RESERVED
  OCCUPIED
  CLEANING
  OUT_OF_SERVICE
}

// Six states in one cycle; OUT_OF_SERVICE is set by the admin for maintenance.
enum OperatingRoomStatus {
  AVAILABLE
  BOOKED
  PREPARING
  IN_SURGERY
  AWAITING_STERILIZATION
  STERILIZING
  OUT_OF_SERVICE
}

// Matches BOOKING_KINDS / BOOKING_STATUSES in @nabd/shared (task 2.18).
enum BookingKind {
  SCHEDULED
  EMERGENCY
}

enum BookingStatus {
  SCHEDULED
  POSTPONED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Matches CLEANING_KINDS / CLEANING_STATUSES in @nabd/shared (task 2.18).
enum CleaningKind {
  CLEANING
  STERILIZATION
}

enum CleaningStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum DoctorStatus {
  AVAILABLE
  BUSY
  ON_LEAVE
}

// Each radiologist is assigned one modality and only receives requests for it.
enum RadiologyModality {
  ENDOSCOPY
  XRAY
  CT
  MRI
  PANORAMIC
  ECHO
}

enum Gender {
  MALE
  FEMALE
}

// AVPU scale, matches CONSCIOUSNESS_LEVELS in @nabd/shared (task 2.10).
enum Consciousness {
  ALERT
  VERBAL
  PAIN
  UNRESPONSIVE
}

// Matches TRIAGE_STATUSES in @nabd/shared.
enum TriageStatus {
  WAITING
  IN_TREATMENT
  TRANSFERRED
  DISCHARGED
}

// Matches DOCTOR_CALL_STATUSES in @nabd/shared.
enum DoctorCallStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// Matches PRESCRIPTION_STATUSES in @nabd/shared (tasks 2.6, 3.10).
enum PrescriptionStatus {
  PENDING
  DISPENSED
  CANCELLED
}

// Matches INVENTORY_CATEGORIES in @nabd/shared (task 3.1): the pharmacy, the
// lab and imaging each keep their own stock.
enum InventoryCategory {
  DRUG
  LAB
  RADIOLOGY
}

// Matches STOCK_MOVEMENT_KINDS in @nabd/shared: stock received, given out for
// a prescription (3.10), used up by the lab or imaging, or corrected by hand.
enum StockMovementKind {
  RESTOCK
  DISPENSE
  USE
  ADJUST
}

// Matches LAB_TEST_STATUSES in @nabd/shared (task 3.4): ordered by the doctor,
// taken by the lab (3.5), done with its result, or withdrawn by the doctor.
enum LabTestStatus {
  REQUESTED
  IN_PROGRESS
  DONE
  CANCELLED
}

// Matches IMAGING_STATUSES in @nabd/shared (task 3.6): ordered by the doctor,
// taken by a radiologist of that modality (3.7, 3.8), reported, or withdrawn.
enum ImagingStatus {
  REQUESTED
  IN_PROGRESS
  DONE
  CANCELLED
}

// Matches LAB_PRIORITIES in @nabd/shared: urgent ones go first on the lab board
// and on the radiology board.
enum LabPriority {
  ROUTINE
  URGENT
}

// Matches REPORT_KINDS in @nabd/shared (task 3.11); the accountant's monthly
// report joins in 4.19.
enum ReportKind {
  PHARMACY
}

// Matches NOTIFICATION_TYPES in @nabd/shared (task 2.2).
enum NotificationType {
  DOCTOR_CALL
  OPERATION_POSTPONED
  OPERATION_ENDED
  CLEANING_REQUEST
  BED_DISCHARGED
  LAB_RESULT
  IMAGING_RESULT
  CONSULTATION_REQUEST
  CONSULTATION_REPLY
  LOW_STOCK
  LEAVE_REQUEST
  PURCHASE_REQUEST
  REQUEST_DECIDED
  MEETING_REQUEST
  COMPLAINT
  MEDICATION_REMINDER
  FOLLOW_UP_REMINDER
  APPOINTMENT_CANCELLED
  REPORT_SUBMITTED
}

// ─── Structure ────────────────────────────────────────────────────────────────

model Hospital {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  address   String
  phone     String
  email     String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments        Department[]
  rooms              Room[]
  beds               Bed[]
  operatingRooms     OperatingRoom[]
  users              User[]
  doctorProfiles     DoctorProfile[]
  staffProfiles      StaffProfile[]
  patients           Patient[]
  refreshTokens      RefreshToken[]
  cleanerAssignments CleanerAssignment[]
  notifications      Notification[]
  medicalRecords     MedicalRecord[]
  doctorReports      DoctorReport[]
  prescriptions      Prescription[]
  prescriptionItems  PrescriptionItem[]
  triageAssessments  TriageAssessment[]
  doctorCalls        DoctorCall[]
  operationBookings  OperationBooking[]
  roomStatusChanges  OperatingRoomStatusChange[]
  cleaningRequests   CleaningRequest[]
  inventoryItems     InventoryItem[]
  stockMovements     StockMovement[]
  labTests           LabTest[]
  radiologyImages    RadiologyImage[]
  reports            Report[]
  bedAssignments     BedAssignment[]
  bedStatusChanges   BedStatusChange[]
  consultations      Consultation[]
}

model Department {
  id         String          @id @default(uuid(7)) @db.Uuid
  hospitalId String          @db.Uuid
  name       String
  code       DepartmentCode?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  hospital         Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  rooms            Room[]
  staff            StaffProfile[]
  cleaners         CleanerAssignment[]
  erTransfers      TriageAssessment[]
  cleaningRequests CleaningRequest[]

  @@unique([hospitalId, name])
  @@unique([hospitalId, code])
  @@index([hospitalId])
}

model Room {
  id           String   @id @default(uuid(7)) @db.Uuid
  hospitalId   String   @db.Uuid
  departmentId String   @db.Uuid
  number       String
  floor        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hospital   Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  beds       Bed[]

  @@unique([departmentId, number])
  @@index([hospitalId])
}

model Bed {
  id              String    @id @default(uuid(7)) @db.Uuid
  hospitalId      String    @db.Uuid
  roomId          String    @db.Uuid
  label           String
  status          BedStatus @default(EMPTY)
  statusChangedAt DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital         Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  room             Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  cleaningRequests CleaningRequest[]
  assignments      BedAssignment[]
  statusChanges    BedStatusChange[]

  @@unique([roomId, label])
  @@index([hospitalId, status])
}

model OperatingRoom {
  id              String              @id @default(uuid(7)) @db.Uuid
  hospitalId      String              @db.Uuid
  name            String
  status          OperatingRoomStatus @default(AVAILABLE)
  statusChangedAt DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  hospital         Hospital                    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bookings         OperationBooking[]
  statusChanges    OperatingRoomStatusChange[]
  cleaningRequests CleaningRequest[]

  @@unique([hospitalId, name])
  @@index([hospitalId, status])
}

// ─── Users ────────────────────────────────────────────────────────────────────

// One table for all ten roles; role-specific details live in the profile tables.
// Email is unique per hospital because a patient has a separate account in each
// hospital they visit.
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  hospitalId   String    @db.Uuid
  role         Role
  email        String
  passwordHash String
  fullName     String
  phone        String?
  language     Language  @default(AR)
  theme        Theme     @default(SYSTEM)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  hospital               Hospital                    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staffProfile           StaffProfile?
  doctorProfile          DoctorProfile?
  patient                Patient?
  refreshTokens          RefreshToken[]
  cleanerAssignments     CleanerAssignment[]
  notifications          Notification[]
  treatedRecords         MedicalRecord[]             @relation("TreatingDoctor")
  writtenReports         DoctorReport[]              @relation("ReportAuthor")
  writtenPrescriptions   Prescription[]              @relation("PrescriptionAuthor")
  dispensedPrescriptions Prescription[]              @relation("PrescriptionDispenser")
  triagedVisits          TriageAssessment[]          @relation("TriageNurse")
  receivedCalls          DoctorCall[]                @relation("CalledDoctor")
  placedCalls            DoctorCall[]                @relation("CallingNurse")
  surgeries              OperationBooking[]          @relation("Surgeon")
  bookingsMade           OperationBooking[]          @relation("BookedBy")
  roomStatusChanges      OperatingRoomStatusChange[] @relation("RoomStatusChanger")
  cleaningRequested      CleaningRequest[]           @relation("CleaningRequester")
  cleaningJobs           CleaningRequest[]           @relation("CleaningWorker")
  stockMovements         StockMovement[]             @relation("StockMover")
  labTestsOrdered        LabTest[]                   @relation("LabTestDoctor")
  labTestsDone           LabTest[]                   @relation("LabTestTechnician")
  imagingOrdered         RadiologyImage[]            @relation("ImagingDoctor")
  imagingDone            RadiologyImage[]            @relation("ImagingRadiologist")
  reportsWritten         Report[]                    @relation("ReportAuthor")
  consultationsAsked     Consultation[]              @relation("ConsultationRequester")
  bedAdmissions          BedAssignment[]             @relation("BedAdmittedBy")
  bedDischarges          BedAssignment[]             @relation("BedDischargedBy")
  bedStatusChanges       BedStatusChange[]           @relation("BedStatusChanger")
  consultationsGiven     Consultation[]              @relation("ConsultationConsultant")

  @@unique([hospitalId, email])
  @@index([hospitalId, role])
  @@index([email])
}

// Employment details shared by every staff role (everyone except PATIENT).
model StaffProfile {
  id                String             @id @default(uuid(7)) @db.Uuid
  hospitalId        String             @db.Uuid
  userId            String             @unique @db.Uuid
  departmentId      String?            @db.Uuid
  salary            Decimal            @default(0) @db.Decimal(12, 2)
  hiredAt           DateTime           @default(now()) @db.Date
  // Only for RADIOLOGIST.
  radiologyModality RadiologyModality?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([hospitalId, departmentId])
}

// A cleaner works across several departments (task 1.29); one row per department.
model CleanerAssignment {
  id           String   @id @default(uuid(7)) @db.Uuid
  hospitalId   String   @db.Uuid
  userId       String   @db.Uuid
  departmentId String   @db.Uuid
  createdAt    DateTime @default(now())

  hospital   Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([hospitalId, departmentId])
}

// Doctor-only details, on top of their StaffProfile.
model DoctorProfile {
  id              String       @id @default(uuid(7)) @db.Uuid
  hospitalId      String       @db.Uuid
  userId          String       @unique @db.Uuid
  specialty       String
  status          DoctorStatus @default(AVAILABLE)
  statusChangedAt DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hospitalId, status])
}

// A patient may exist without a login: anonymous ER arrivals, or people registered
// by reception. The account is linked later through userId.
model Patient {
  id          String    @id @default(uuid(7)) @db.Uuid
  hospitalId  String    @db.Uuid
  userId      String?   @unique @db.Uuid
  fullName    String?
  isAnonymous Boolean   @default(false)
  gender      Gender?
  dateOfBirth DateTime? @db.Date
  phone       String?
  nationalId  String?
  bloodType   String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hospital          Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  medicalRecord     MedicalRecord?
  bedAssignments    BedAssignment[]
  erVisits          TriageAssessment[]
  operationBookings OperationBooking[]

  @@unique([hospitalId, nationalId])
  @@index([hospitalId])
}

// ─── Medical file (task 2.6) ──────────────────────────────────────────────────

// The patient's file at this hospital: one per patient, created with them.
// The treating doctor is the one whose patient this is (consultants only get
// temporary read access, task 3.13).
model MedicalRecord {
  id                String   @id @default(uuid(7)) @db.Uuid
  hospitalId        String   @db.Uuid
  patientId         String   @unique @db.Uuid
  doctorId          String?  @db.Uuid
  allergies         String?
  chronicConditions String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  hospital      Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient       Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User?            @relation("TreatingDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  reports       DoctorReport[]
  prescriptions Prescription[]
  labTests      LabTest[]
  imaging       RadiologyImage[]
  consultations Consultation[]

  @@index([hospitalId, doctorId])
}

// Reports and prescriptions are medical history: removing a doctor's account
// keeps them, with the author's name saved alongside.
model DoctorReport {
  id             String   @id @default(uuid(7)) @db.Uuid
  hospitalId     String   @db.Uuid
  recordId       String   @db.Uuid
  doctorId       String?  @db.Uuid
  doctorName     String
  title          String
  diagnosis      String?
  content        String
  // Set when the report is a consultant's reply (task 3.14).
  consultationId String?  @unique @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  record       MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  doctor       User?         @relation("ReportAuthor", fields: [doctorId], references: [id], onDelete: SetNull)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([recordId, createdAt])
  @@index([hospitalId])
}

model Prescription {
  id              String             @id @default(uuid(7)) @db.Uuid
  hospitalId      String             @db.Uuid
  recordId        String             @db.Uuid
  doctorId        String?            @db.Uuid
  doctorName      String
  status          PrescriptionStatus @default(PENDING)
  notes           String?
  dispensedAt     DateTime?
  // Who dispensed it (task 3.10); the name stays if their account goes.
  dispensedById   String?            @db.Uuid
  dispensedByName String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  hospital    Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  record      MedicalRecord      @relation(fields: [recordId], references: [id], onDelete: Cascade)
  doctor      User?              @relation("PrescriptionAuthor", fields: [doctorId], references: [id], onDelete: SetNull)
  dispensedBy User?              @relation("PrescriptionDispenser", fields: [dispensedById], references: [id], onDelete: SetNull)
  items       PrescriptionItem[]

  @@index([recordId, createdAt])
  // The pharmacy's queue (task 3.10).
  @@index([hospitalId, status])
}

// One medicine of a prescription; dispensing and reminders (3.10, 3.26) work per item.
model PrescriptionItem {
  id                String  @id @default(uuid(7)) @db.Uuid
  hospitalId        String  @db.Uuid
  prescriptionId    String  @db.Uuid
  drugName          String
  dose              String
  frequency         String
  durationDays      Int?
  instructions      String?
  // What was handed over (task 3.10): how many of which stock item, or null
  // when it was not available. The item's name and unit are kept as they were.
  dispensedQuantity Int?
  dispensedName     String?
  dispensedUnit     String?

  hospital     Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  prescription Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  movements    StockMovement[]

  @@index([prescriptionId])
}

// ─── Emergency room (task 2.10) ───────────────────────────────────────────────

// One emergency visit: created at the quick registration (2.11), filled by the
// triage form (2.12). The suggested ESI level comes from the rules (2.13); the
// nurse may set another with a reason (2.14). Ranges are also checked by the
// database (see the migration).
model TriageAssessment {
  id               String         @id @default(uuid(7)) @db.Uuid
  hospitalId       String         @db.Uuid
  patientId        String         @db.Uuid
  nurseId          String?        @db.Uuid
  status           TriageStatus   @default(WAITING)
  arrivedAt        DateTime       @default(now())
  chiefComplaint   String?
  // How they arrived and, for unidentified patients, what they look like (2.11).
  arrivalNote      String?
  pulse            Int?
  systolic         Int?
  diastolic        Int?
  respiratoryRate  Int?
  oxygenSaturation Int?
  temperature      Decimal?       @db.Decimal(4, 1)
  consciousness    Consciousness?
  breathing        Boolean?
  painScore        Int?
  expectedExams    Int?
  suggestedLevel   Int?
  level            Int?
  overrideReason   String?
  assessedAt       DateTime?
  // Where the patient went after the ER (2.17).
  departmentId     String?        @db.Uuid
  closedAt         DateTime?
  // The transfer or discharge note (2.17).
  closingNote      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  hospital       Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bedAssignments BedAssignment[]
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nurse          User?              @relation("TriageNurse", fields: [nurseId], references: [id], onDelete: SetNull)
  department     Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  calls          DoctorCall[]
  bookings       OperationBooking[]

  // The waiting list: by status, then level, then arrival (2.15).
  @@index([hospitalId, status, level, arrivedAt])
  @@index([patientId])
}

// A nurse calls a specific doctor to an ER patient (2.16); the doctor accepts
// or declines (2.9).
model DoctorCall {
  id            String           @id @default(uuid(7)) @db.Uuid
  hospitalId    String           @db.Uuid
  triageId      String           @db.Uuid
  doctorId      String?          @db.Uuid
  calledById    String?          @db.Uuid
  status        DoctorCallStatus @default(PENDING)
  declineReason String?
  respondedAt   DateTime?
  createdAt     DateTime         @default(now())

  hospital Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  triage   TriageAssessment @relation(fields: [triageId], references: [id], onDelete: Cascade)
  doctor   User?            @relation("CalledDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  calledBy User?            @relation("CallingNurse", fields: [calledById], references: [id], onDelete: SetNull)

  @@index([doctorId, status])
  @@index([triageId])
}

// ─── Operating rooms and cleaning (task 2.18) ─────────────────────────────────

// A booking of an operating room. Scheduled bookings have a room and a time
// (no overlaps, 2.20); an emergency one may wait for the first room that frees
// up and pushes scheduled ones back (2.21).
model OperationBooking {
  id              String        @id @default(uuid(7)) @db.Uuid
  hospitalId      String        @db.Uuid
  operatingRoomId String?       @db.Uuid
  patientId       String        @db.Uuid
  triageId        String?       @db.Uuid
  surgeonId       String?       @db.Uuid
  surgeonName     String
  bookedById      String?       @db.Uuid
  kind            BookingKind   @default(SCHEDULED)
  status          BookingStatus @default(SCHEDULED)
  procedure       String
  notes           String?
  startsAt        DateTime
  endsAt          DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital      Hospital                    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  operatingRoom OperatingRoom?              @relation(fields: [operatingRoomId], references: [id], onDelete: SetNull)
  patient       Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  triage        TriageAssessment?           @relation(fields: [triageId], references: [id], onDelete: SetNull)
  surgeon       User?                       @relation("Surgeon", fields: [surgeonId], references: [id], onDelete: SetNull)
  bookedBy      User?                       @relation("BookedBy", fields: [bookedById], references: [id], onDelete: SetNull)
  statusChanges OperatingRoomStatusChange[]

  // Overlap checks per room, and the day's list.
  @@index([operatingRoomId, startsAt])
  @@index([hospitalId, status, startsAt])
}

// Every change of an operating room's status: from, to, who and when.
model OperatingRoomStatusChange {
  id              String              @id @default(uuid(7)) @db.Uuid
  hospitalId      String              @db.Uuid
  operatingRoomId String              @db.Uuid
  bookingId       String?             @db.Uuid
  fromStatus      OperatingRoomStatus
  toStatus        OperatingRoomStatus
  changedById     String?             @db.Uuid
  changedByName   String
  createdAt       DateTime            @default(now())

  hospital      Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  operatingRoom OperatingRoom     @relation(fields: [operatingRoomId], references: [id], onDelete: Cascade)
  booking       OperationBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  changedBy     User?             @relation("RoomStatusChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([operatingRoomId, createdAt])
}

// A cleaning or sterilization job for the cleaners of a department (2.23–2.25,
// 3.17): an operating room after surgery, a bed after discharge, or a place.
model CleaningRequest {
  id              String         @id @default(uuid(7)) @db.Uuid
  hospitalId      String         @db.Uuid
  departmentId    String         @db.Uuid
  kind            CleaningKind   @default(CLEANING)
  status          CleaningStatus @default(PENDING)
  operatingRoomId String?        @db.Uuid
  bedId           String?        @db.Uuid
  place           String?
  note            String?
  requestedById   String?        @db.Uuid
  assignedToId    String?        @db.Uuid
  createdAt       DateTime       @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department    Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  operatingRoom OperatingRoom? @relation(fields: [operatingRoomId], references: [id], onDelete: SetNull)
  bed           Bed?           @relation(fields: [bedId], references: [id], onDelete: SetNull)
  requestedBy   User?          @relation("CleaningRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  assignedTo    User?          @relation("CleaningWorker", fields: [assignedToId], references: [id], onDelete: SetNull)

  // A cleaner's board: their departments' open jobs (2.24).
  @@index([hospitalId, departmentId, status])
}

// ─── Laboratory (task 3.4) ────────────────────────────────────────────────────

// One test a doctor ordered for a patient, from the test list (code). The lab
// takes it, writes or uploads its result into the patient's file (3.5). Like
// reports, it stays in the file with the doctor's name if their account goes.
model LabTest {
  id             String        @id @default(uuid(7)) @db.Uuid
  hospitalId     String        @db.Uuid
  recordId       String        @db.Uuid
  // A code of LAB_TEST_CODES in @nabd/shared; each client names it in its language.
  code           String
  priority       LabPriority   @default(ROUTINE)
  notes          String?
  status         LabTestStatus @default(REQUESTED)
  doctorId       String?       @db.Uuid
  doctorName     String
  technicianId   String?       @db.Uuid
  technicianName String?
  // The result (3.5): written values and/or an uploaded report file.
  result         String?
  resultFile     String?
  abnormal       Boolean?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  hospital   Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  record     MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  doctor     User?         @relation("LabTestDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  technician User?         @relation("LabTestTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  // The lab board: by status, urgent first, oldest first (3.5).
  @@index([hospitalId, status, priority, createdAt])
  @@index([recordId, createdAt])
}

// ─── Radiology (task 3.6) ─────────────────────────────────────────────────────

// An imaging study a doctor ordered for a patient: which modality (each
// radiologist handles one, 3.7) and what part of the body. The radiologist
// uploads the images and writes the report (3.8); the doctor views them in the
// file (3.9). The doctor's name stays if their account goes.
model RadiologyImage {
  id              String            @id @default(uuid(7)) @db.Uuid
  hospitalId      String            @db.Uuid
  recordId        String            @db.Uuid
  modality        RadiologyModality
  bodyPart        String
  // Why it is asked for: the clinical question.
  reason          String?
  priority        LabPriority       @default(ROUTINE)
  status          ImagingStatus     @default(REQUESTED)
  doctorId        String?           @db.Uuid
  doctorName      String
  radiologistId   String?           @db.Uuid
  radiologistName String?
  // The radiologist's report and the stored image files (3.8).
  report          String?
  imageFiles      String[]          @default([])
  abnormal        Boolean?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  hospital    Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  record      MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  doctor      User?         @relation("ImagingDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  radiologist User?         @relation("ImagingRadiologist", fields: [radiologistId], references: [id], onDelete: SetNull)

  // A radiologist's board: their modality, by status, urgent first (3.7, 3.8).
  @@index([hospitalId, modality, status, priority, createdAt])
  @@index([recordId, createdAt])
}

// ─── Inventory (task 3.1) ─────────────────────────────────────────────────────

// One stocked thing: a medicine, a lab reagent, a film. Below its minimum the
// department is warned (3.3). Quantities never go below zero (see the migration).
model InventoryItem {
  id          String            @id @default(uuid(7)) @db.Uuid
  hospitalId  String            @db.Uuid
  category    InventoryCategory
  name        String
  // How it is counted: box, ampoule, strip, film…
  unit        String
  quantity    Int               @default(0)
  minQuantity Int               @default(0)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  hospital  Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@unique([hospitalId, category, name])
  @@index([hospitalId, category])
}

// Every change of an item's quantity: by how much, what it left, who and why.
// Quantities change only through these (moveStock in inventory.service.ts).
model StockMovement {
  id                 String            @id @default(uuid(7)) @db.Uuid
  hospitalId         String            @db.Uuid
  itemId             String            @db.Uuid
  kind               StockMovementKind
  // Positive in, negative out.
  change             Int
  quantityAfter      Int
  reason             String?
  byId               String?           @db.Uuid
  byName             String
  // The prescription line it was dispensed for (3.10).
  prescriptionItemId String?           @db.Uuid
  createdAt          DateTime          @default(now())

  hospital         Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  item             InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  by               User?             @relation("StockMover", fields: [byId], references: [id], onDelete: SetNull)
  prescriptionItem PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([hospitalId, createdAt])
}

// ─── Beds (tasks 3.15–3.18) ──────────────────────────────────────────────────

// A patient in a bed: from admission to discharge (dischargedAt). A bed has at
// most one open stay and a patient at most one (partial unique indexes in the
// migration). Names are kept so the history survives removed accounts.
model BedAssignment {
  id               String    @id @default(uuid(7)) @db.Uuid
  hospitalId       String    @db.Uuid
  bedId            String    @db.Uuid
  patientId        String    @db.Uuid
  // The ER visit it came from, when it did (2.17 transfers).
  visitId          String?   @db.Uuid
  notes            String?
  admittedById     String?   @db.Uuid
  admittedByName   String
  admittedAt       DateTime  @default(now())
  dischargedAt     DateTime?
  dischargedById   String?   @db.Uuid
  dischargedByName String?

  hospital     Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bed          Bed               @relation(fields: [bedId], references: [id], onDelete: Cascade)
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit        TriageAssessment? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  admittedBy   User?             @relation("BedAdmittedBy", fields: [admittedById], references: [id], onDelete: SetNull)
  dischargedBy User?             @relation("BedDischargedBy", fields: [dischargedById], references: [id], onDelete: SetNull)
  changes      BedStatusChange[]

  @@index([bedId, admittedAt])
  @@index([hospitalId, patientId])
}

// Every change of a bed's state, with who made it and, when it belongs to one,
// the stay. Written only by changeBedStatus (bedStatus.service.ts).
model BedStatusChange {
  id            String    @id @default(uuid(7)) @db.Uuid
  hospitalId    String    @db.Uuid
  bedId         String    @db.Uuid
  assignmentId  String?   @db.Uuid
  fromStatus    BedStatus
  toStatus      BedStatus
  reason        String?
  changedById   String?   @db.Uuid
  changedByName String
  createdAt     DateTime  @default(now())

  hospital   Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bed        Bed            @relation(fields: [bedId], references: [id], onDelete: Cascade)
  assignment BedAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  changedBy  User?          @relation("BedStatusChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([bedId, createdAt])
}

// ─── Consultations (tasks 3.12–3.14) ─────────────────────────────────────────

// Matches CONSULTATION_STATUSES in @nabd/shared.
enum ConsultationStatus {
  PENDING
  ANSWERED
  CANCELLED
}

// The treating doctor shares a patient's file with another doctor and asks a
// question. The consultant reads the file only while it is open (3.13) and
// answers with a report or an order that joins the file (3.14). Names are kept
// so the history survives removed accounts.
model Consultation {
  id             String             @id @default(uuid(7)) @db.Uuid
  hospitalId     String             @db.Uuid
  recordId       String             @db.Uuid
  requesterId    String?            @db.Uuid
  requesterName  String
  consultantId   String?            @db.Uuid
  consultantName String
  question       String
  status         ConsultationStatus @default(PENDING)
  reply          String?
  answeredAt     DateTime?
  createdAt      DateTime           @default(now())
  replyReport    DoctorReport?

  hospital   Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  record     MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  requester  User?         @relation("ConsultationRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  consultant User?         @relation("ConsultationConsultant", fields: [consultantId], references: [id], onDelete: SetNull)

  @@index([hospitalId, consultantId, status])
  @@index([recordId])
}

// ─── Department reports (task 3.11) ───────────────────────────────────────────

// A report a department sends the admin for a period. Its figures are worked
// out when it is sent and kept as they were (data), whatever happens later.
model Report {
  id         String     @id @default(uuid(7)) @db.Uuid
  hospitalId String     @db.Uuid
  kind       ReportKind
  periodFrom DateTime
  periodTo   DateTime
  data       Json
  notes      String?
  authorId   String?    @db.Uuid
  authorName String
  // When the admin first opened it.
  readAt     DateTime?
  createdAt  DateTime   @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  author   User?    @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([hospitalId, kind, createdAt])
}

// ─── System ───────────────────────────────────────────────────────────────────

// One row per recipient, so each person has their own unread list (task 2.2).
// The sentence is written by the client from the type and data, in the
// reader's language.
model Notification {
  id         String           @id @default(uuid(7)) @db.Uuid
  hospitalId String           @db.Uuid
  userId     String           @db.Uuid
  type       NotificationType
  data       Json             @default("{}")
  urgent     Boolean          @default(false)
  link       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([hospitalId])
}

// Only a hash of the token is stored, so a leaked database cannot be used to log in.
model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  hospitalId String    @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hospitalId])
}
