// Nabd database schema.
// Every model except Hospital carries a hospitalId and every query is scoped by it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DOCTOR
  NURSE
  PHARMACIST
  LAB_TECHNICIAN
  RADIOLOGIST
  CLEANER
  RECEPTIONIST
  ACCOUNTANT
  PATIENT
}

enum Language {
  AR
  EN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// Built-in departments the admin can add in one click. The UI translates them by
// code; custom departments have no code and show their stored name.
// A nurse's type (ER, OR, ward) follows the code of the department they work in.
enum DepartmentCode {
  EMERGENCY
  OPERATIONS
  INTERNAL_MEDICINE
  NEUROLOGY
  ORTHOPEDICS
  CARDIOLOGY
  PLASTIC_SURGERY
  OPHTHALMOLOGY
  GYNECOLOGY
  LABORATORY
  RADIOLOGY
  PHARMACY
}

enum BedStatus {
  EMPTY
  RESERVED
  OCCUPIED
  CLEANING
  OUT_OF_SERVICE
}

// Six states in one cycle; OUT_OF_SERVICE is set by the admin for maintenance.
enum OperatingRoomStatus {
  AVAILABLE
  BOOKED
  PREPARING
  IN_SURGERY
  AWAITING_STERILIZATION
  STERILIZING
  OUT_OF_SERVICE
}

enum DoctorStatus {
  AVAILABLE
  BUSY
  ON_LEAVE
}

// Each radiologist is assigned one modality and only receives requests for it.
enum RadiologyModality {
  ENDOSCOPY
  XRAY
  CT
  MRI
  PANORAMIC
  ECHO
}

enum Gender {
  MALE
  FEMALE
}

// AVPU scale, matches CONSCIOUSNESS_LEVELS in @nabd/shared (task 2.10).
enum Consciousness {
  ALERT
  VERBAL
  PAIN
  UNRESPONSIVE
}

// Matches TRIAGE_STATUSES in @nabd/shared.
enum TriageStatus {
  WAITING
  IN_TREATMENT
  TRANSFERRED
  DISCHARGED
}

// Matches DOCTOR_CALL_STATUSES in @nabd/shared.
enum DoctorCallStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// Matches PRESCRIPTION_STATUSES in @nabd/shared (tasks 2.6, 3.10).
enum PrescriptionStatus {
  PENDING
  DISPENSED
  CANCELLED
}

// Matches NOTIFICATION_TYPES in @nabd/shared (task 2.2).
enum NotificationType {
  DOCTOR_CALL
  OPERATION_POSTPONED
  OPERATION_ENDED
  CLEANING_REQUEST
  BED_DISCHARGED
  LAB_RESULT
  IMAGING_RESULT
  CONSULTATION_REQUEST
  CONSULTATION_REPLY
  LOW_STOCK
  LEAVE_REQUEST
  PURCHASE_REQUEST
  REQUEST_DECIDED
  MEETING_REQUEST
  COMPLAINT
  MEDICATION_REMINDER
  FOLLOW_UP_REMINDER
  APPOINTMENT_CANCELLED
}

// ─── Structure ────────────────────────────────────────────────────────────────

model Hospital {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  address   String
  phone     String
  email     String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments        Department[]
  rooms              Room[]
  beds               Bed[]
  operatingRooms     OperatingRoom[]
  users              User[]
  doctorProfiles     DoctorProfile[]
  staffProfiles      StaffProfile[]
  patients           Patient[]
  refreshTokens      RefreshToken[]
  cleanerAssignments CleanerAssignment[]
  notifications      Notification[]
  medicalRecords     MedicalRecord[]
  doctorReports      DoctorReport[]
  prescriptions      Prescription[]
  prescriptionItems  PrescriptionItem[]
  triageAssessments  TriageAssessment[]
  doctorCalls        DoctorCall[]
}

model Department {
  id         String          @id @default(uuid(7)) @db.Uuid
  hospitalId String          @db.Uuid
  name       String
  code       DepartmentCode?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  hospital    Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  rooms       Room[]
  staff       StaffProfile[]
  cleaners    CleanerAssignment[]
  erTransfers TriageAssessment[]

  @@unique([hospitalId, name])
  @@unique([hospitalId, code])
  @@index([hospitalId])
}

model Room {
  id           String   @id @default(uuid(7)) @db.Uuid
  hospitalId   String   @db.Uuid
  departmentId String   @db.Uuid
  number       String
  floor        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hospital   Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  beds       Bed[]

  @@unique([departmentId, number])
  @@index([hospitalId])
}

model Bed {
  id              String    @id @default(uuid(7)) @db.Uuid
  hospitalId      String    @db.Uuid
  roomId          String    @db.Uuid
  label           String
  status          BedStatus @default(EMPTY)
  statusChangedAt DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, label])
  @@index([hospitalId, status])
}

model OperatingRoom {
  id              String              @id @default(uuid(7)) @db.Uuid
  hospitalId      String              @db.Uuid
  name            String
  status          OperatingRoomStatus @default(AVAILABLE)
  statusChangedAt DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, name])
  @@index([hospitalId, status])
}

// ─── Users ────────────────────────────────────────────────────────────────────

// One table for all ten roles; role-specific details live in the profile tables.
// Email is unique per hospital because a patient has a separate account in each
// hospital they visit.
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  hospitalId   String    @db.Uuid
  role         Role
  email        String
  passwordHash String
  fullName     String
  phone        String?
  language     Language  @default(AR)
  theme        Theme     @default(SYSTEM)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  hospital             Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staffProfile         StaffProfile?
  doctorProfile        DoctorProfile?
  patient              Patient?
  refreshTokens        RefreshToken[]
  cleanerAssignments   CleanerAssignment[]
  notifications        Notification[]
  treatedRecords       MedicalRecord[]     @relation("TreatingDoctor")
  writtenReports       DoctorReport[]      @relation("ReportAuthor")
  writtenPrescriptions Prescription[]      @relation("PrescriptionAuthor")
  triagedVisits        TriageAssessment[]  @relation("TriageNurse")
  receivedCalls        DoctorCall[]        @relation("CalledDoctor")
  placedCalls          DoctorCall[]        @relation("CallingNurse")

  @@unique([hospitalId, email])
  @@index([hospitalId, role])
  @@index([email])
}

// Employment details shared by every staff role (everyone except PATIENT).
model StaffProfile {
  id                String             @id @default(uuid(7)) @db.Uuid
  hospitalId        String             @db.Uuid
  userId            String             @unique @db.Uuid
  departmentId      String?            @db.Uuid
  salary            Decimal            @default(0) @db.Decimal(12, 2)
  hiredAt           DateTime           @default(now()) @db.Date
  // Only for RADIOLOGIST.
  radiologyModality RadiologyModality?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([hospitalId, departmentId])
}

// A cleaner works across several departments (task 1.29); one row per department.
model CleanerAssignment {
  id           String   @id @default(uuid(7)) @db.Uuid
  hospitalId   String   @db.Uuid
  userId       String   @db.Uuid
  departmentId String   @db.Uuid
  createdAt    DateTime @default(now())

  hospital   Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([hospitalId, departmentId])
}

// Doctor-only details, on top of their StaffProfile.
model DoctorProfile {
  id              String       @id @default(uuid(7)) @db.Uuid
  hospitalId      String       @db.Uuid
  userId          String       @unique @db.Uuid
  specialty       String
  status          DoctorStatus @default(AVAILABLE)
  statusChangedAt DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hospitalId, status])
}

// A patient may exist without a login: anonymous ER arrivals, or people registered
// by reception. The account is linked later through userId.
model Patient {
  id          String    @id @default(uuid(7)) @db.Uuid
  hospitalId  String    @db.Uuid
  userId      String?   @unique @db.Uuid
  fullName    String?
  isAnonymous Boolean   @default(false)
  gender      Gender?
  dateOfBirth DateTime? @db.Date
  phone       String?
  nationalId  String?
  bloodType   String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hospital      Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  medicalRecord MedicalRecord?
  erVisits      TriageAssessment[]

  @@unique([hospitalId, nationalId])
  @@index([hospitalId])
}

// ─── Medical file (task 2.6) ──────────────────────────────────────────────────

// The patient's file at this hospital: one per patient, created with them.
// The treating doctor is the one whose patient this is (consultants only get
// temporary read access, task 3.13).
model MedicalRecord {
  id                String   @id @default(uuid(7)) @db.Uuid
  hospitalId        String   @db.Uuid
  patientId         String   @unique @db.Uuid
  doctorId          String?  @db.Uuid
  allergies         String?
  chronicConditions String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  hospital      Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        User?          @relation("TreatingDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  reports       DoctorReport[]
  prescriptions Prescription[]

  @@index([hospitalId, doctorId])
}

// Reports and prescriptions are medical history: removing a doctor's account
// keeps them, with the author's name saved alongside.
model DoctorReport {
  id         String   @id @default(uuid(7)) @db.Uuid
  hospitalId String   @db.Uuid
  recordId   String   @db.Uuid
  doctorId   String?  @db.Uuid
  doctorName String
  title      String
  diagnosis  String?
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  record   MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  doctor   User?         @relation("ReportAuthor", fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([recordId, createdAt])
  @@index([hospitalId])
}

model Prescription {
  id          String             @id @default(uuid(7)) @db.Uuid
  hospitalId  String             @db.Uuid
  recordId    String             @db.Uuid
  doctorId    String?            @db.Uuid
  doctorName  String
  status      PrescriptionStatus @default(PENDING)
  notes       String?
  dispensedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  hospital Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  record   MedicalRecord      @relation(fields: [recordId], references: [id], onDelete: Cascade)
  doctor   User?              @relation("PrescriptionAuthor", fields: [doctorId], references: [id], onDelete: SetNull)
  items    PrescriptionItem[]

  @@index([recordId, createdAt])
  // The pharmacy's queue (task 3.10).
  @@index([hospitalId, status])
}

// One medicine of a prescription; dispensing and reminders (3.10, 3.26) work per item.
model PrescriptionItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  hospitalId     String  @db.Uuid
  prescriptionId String  @db.Uuid
  drugName       String
  dose           String
  frequency      String
  durationDays   Int?
  instructions   String?

  hospital     Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

// ─── Emergency room (task 2.10) ───────────────────────────────────────────────

// One emergency visit: created at the quick registration (2.11), filled by the
// triage form (2.12). The suggested ESI level comes from the rules (2.13); the
// nurse may set another with a reason (2.14). Ranges are also checked by the
// database (see the migration).
model TriageAssessment {
  id               String         @id @default(uuid(7)) @db.Uuid
  hospitalId       String         @db.Uuid
  patientId        String         @db.Uuid
  nurseId          String?        @db.Uuid
  status           TriageStatus   @default(WAITING)
  arrivedAt        DateTime       @default(now())
  chiefComplaint   String?
  // How they arrived and, for unidentified patients, what they look like (2.11).
  arrivalNote      String?
  pulse            Int?
  systolic         Int?
  diastolic        Int?
  respiratoryRate  Int?
  oxygenSaturation Int?
  temperature      Decimal?       @db.Decimal(4, 1)
  consciousness    Consciousness?
  breathing        Boolean?
  painScore        Int?
  expectedExams    Int?
  suggestedLevel   Int?
  level            Int?
  overrideReason   String?
  assessedAt       DateTime?
  // Where the patient went after the ER (2.17).
  departmentId     String?        @db.Uuid
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  hospital   Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient    Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nurse      User?        @relation("TriageNurse", fields: [nurseId], references: [id], onDelete: SetNull)
  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  calls      DoctorCall[]

  // The waiting list: by status, then level, then arrival (2.15).
  @@index([hospitalId, status, level, arrivedAt])
  @@index([patientId])
}

// A nurse calls a specific doctor to an ER patient (2.16); the doctor accepts
// or declines (2.9).
model DoctorCall {
  id            String           @id @default(uuid(7)) @db.Uuid
  hospitalId    String           @db.Uuid
  triageId      String           @db.Uuid
  doctorId      String?          @db.Uuid
  calledById    String?          @db.Uuid
  status        DoctorCallStatus @default(PENDING)
  declineReason String?
  respondedAt   DateTime?
  createdAt     DateTime         @default(now())

  hospital Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  triage   TriageAssessment @relation(fields: [triageId], references: [id], onDelete: Cascade)
  doctor   User?            @relation("CalledDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  calledBy User?            @relation("CallingNurse", fields: [calledById], references: [id], onDelete: SetNull)

  @@index([doctorId, status])
  @@index([triageId])
}

// ─── System ───────────────────────────────────────────────────────────────────

// One row per recipient, so each person has their own unread list (task 2.2).
// The sentence is written by the client from the type and data, in the
// reader's language.
model Notification {
  id         String           @id @default(uuid(7)) @db.Uuid
  hospitalId String           @db.Uuid
  userId     String           @db.Uuid
  type       NotificationType
  data       Json             @default("{}")
  urgent     Boolean          @default(false)
  link       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([hospitalId])
}

// Only a hash of the token is stored, so a leaked database cannot be used to log in.
model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  hospitalId String    @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hospitalId])
}
