# Copy to .env and adjust
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nabd?schema=public

# Password for every demo account created by `npm run db:seed`
SEED_PASSWORD=Admin@12345

# Signs access tokens. Use a long random value in every environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Lifetimes: access token in seconds (15 min), refresh token in days
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Where uploaded files are stored (served only through the API)
UPLOADS_DIR=uploads
